# =============================================================================
# NetMonitor Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values for your environment.
# DO NOT COMMIT REAL PASSWORDS, SECRETS, OR TOKENS TO SOURCE CONTROL.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend Server Configuration
# -----------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# -----------------------------------------------------------------------------
# 2. Prometheus & Telemetry Exporters
# -----------------------------------------------------------------------------
# Internal URL where Prometheus server is listening
PROMETHEUS_URL=http://127.0.0.1:9090

# Directory where NetMonitor writes dynamic file_sd target files
PROMETHEUS_TARGETS_DIR=/etc/prometheus/targets

# Prometheus SNMP Exporter URL
SNMP_EXPORTER_URL=http://127.0.0.1:9116

# Prometheus Blackbox Exporter URL (ICMP ping probe)
BLACKBOX_EXPORTER_URL=http://127.0.0.1:9115

# -----------------------------------------------------------------------------
# 3. Grafana Integration (Optional)
# -----------------------------------------------------------------------------
# URL where Grafana instance is listening for embedded dashboard panels
GRAFANA_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 4. Authentication, Sessions & Break-Glass Security
# -----------------------------------------------------------------------------
# Cryptographic secret for signing session cookies (Generate random 64-char string)
SESSION_SECRET=

# Cryptographic secret for signing API JWT tokens (Generate random 64-char string)
JWT_SECRET=

# Emergency break-glass local administrator password (minimum 8 characters)
# If omitted, default emergency password applies until configured in setup wizard
EMERGENCY_PASSWORD=

# -----------------------------------------------------------------------------
# 5. Default Network Discovery & SNMP Profiles
# -----------------------------------------------------------------------------
# Default CIDR subnet used for initial topology discovery sweep
DEFAULT_DISCOVERY_CIDR=192.168.1.0/24

# Default SNMP v2c community string for discovery and device onboarding
DEFAULT_SNMP_COMMUNITY=public

# Default SNMP Auth Profile name defined in /etc/prometheus/snmp.yml
DEFAULT_SNMP_AUTH_PROFILE=public_v2

# -----------------------------------------------------------------------------
# 6. Alert Notifications & Webhooks (Optional)
# -----------------------------------------------------------------------------
# LINE Notify Token (Legacy service)
LINE_NOTIFY_TOKEN=

# LINE Messaging API Long-Lived Channel Access Token
LINE_CHANNEL_ACCESS_TOKEN=

# Target LINE User ID (U...) or Group ID (C...) to receive alert cards
LINE_USER_ID=

# Generic HTTP POST Webhook URL (Slack, Telegram, Discord, or Custom NOC endpoint)
GENERIC_WEBHOOK_URL=
